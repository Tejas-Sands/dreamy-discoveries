              "emotion": "thinking",
              "action": "look"
            },
            {
              "text": "Little ones are easier to lift.",
              "speaker": "character",
              "emotion": "thinking",
              "action": "think"
            },
            {
              "text": "But they have much more weight above them.",
              "speaker": "friend",
              "emotion": "thinking",
              "action": "think"
            }
          ]
        },
        {
          "kind": "story",
          "background": "bedroom",
          "character": "squirrel",
          "secondCharacter": "owl",
          "energy": "upbeat",
          "holdSec": 2,
          "prop": "🧱",
          "question": null,
          "lines": [
            {
