              "emotion": "surprised",
              "action": "look"
            },
            {
              "text": "Ozzy lowered the top before it fell.",
              "speaker": "narrator",
              "emotion": "surprised",
              "action": "look"
            },
            {
              "text": "Our tower is trying to sit down.",
              "speaker": "character",
              "emotion": "surprised",
              "action": "nod"
            },
            {
              "text": "Let's place these blocks beside the rug.",
              "speaker": "friend",
              "emotion": "surprised",
              "action": "nod"
            }
          ]
