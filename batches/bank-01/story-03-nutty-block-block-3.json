              "emotion": "happy",
              "action": "look"
            },
            {
              "text": "Mine will have a window at the top.",
              "speaker": "character",
              "emotion": "happy",
              "action": "nod"
            },
            {
              "text": "Then we need a wide doorway underneath.",
              "speaker": "friend",
              "emotion": "happy",
              "action": "nod"
            }
          ]
        },
        {
          "kind": "story",
          "background": "bedroom",
          "character": "squirrel",
          "secondCharacter": "owl",
          "energy": "upbeat",
          "holdSec": 1,
          "prop": "🧱",
          "question": null,
          "lines": [
            {
              "text": "Nutty stacked the smallest blocks first.",
              "speaker": "narrator",
              "emotion": "thinking",
              "action": "look"
            },
            {
              "text": "He balanced bigger blocks above their heads.",
