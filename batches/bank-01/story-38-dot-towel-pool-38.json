            {
              "text": "I can bring everyone their own towel.",
              "speaker": "character",
              "emotion": "happy",
              "action": "nod"
            },
            {
              "text": "These towels are rather big beside you.",
              "speaker": "friend",
              "emotion": "happy",
              "action": "nod"
            }
