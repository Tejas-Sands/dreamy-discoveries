            {
              "text": "The cloud has followed me again!",
              "speaker": "character",
              "emotion": "thinking",
              "action": "think"
            },
            {
              "text": "Let's put it back before you try walking.",
              "speaker": "friend",
              "emotion": "thinking",
              "action": "think"
            }
          ]
