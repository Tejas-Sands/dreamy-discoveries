        {
          "kind": "story",
          "background": "pond",
          "character": "ladybug",
          "secondCharacter": "frog",
          "energy": "upbeat",
          "holdSec": 1,
          "prop": "🧺",
          "question": null,
          "lines": [
            {
              "text": "Dot pulled the top towel with both front feet.",
