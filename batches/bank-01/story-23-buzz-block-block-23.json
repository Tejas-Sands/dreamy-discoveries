            {
              "text": "Ozzy carried the wide blocks for its base.",
              "speaker": "narrator",
              "emotion": "happy",
              "action": "look"
            },
            {
              "text": "My small blocks can make the curved top.",
              "speaker": "character",
              "emotion": "happy",
              "action": "nod"
            },
            {
              "text": "Then we need a way to reach both sides.",
              "speaker": "friend",
              "emotion": "happy",
              "action": "nod"
            }
          ]
        },
        {
          "kind": "story",
          "background": "playground",
          "character": "bee",
          "secondCharacter": "owl",
          "energy": "upbeat",
          "holdSec": 1,
          "prop": "⛵",
          "question": null,
          "lines": [
            {
              "text": "Buzz rushed through the opening with three blocks.",
              "speaker": "narrator",
              "emotion": "thinking",
              "action": "look"
            },
            {
              "text": "Ozzy tried coming in from the opposite side.",
              "speaker": "narrator",
              "emotion": "thinking",
              "action": "look"
            },
            {
              "text": "Excuse me! I have an important delivery.",
              "speaker": "character",
              "emotion": "thinking",
              "action": "think"
            },
            {
              "text": "So do I, and neither delivery can pass.",
              "speaker": "friend",
              "emotion": "thinking",
              "action": "think"
            }
          ]
        },
        {
          "kind": "story",
          "background": "playground",
          "character": "bee",
          "secondCharacter": "owl",
          "energy": "upbeat",
          "holdSec": 2,
          "prop": "⛵",
          "question": null,
          "lines": [
            {
