          "lines": [
            {
              "text": "Buzz's block bridge had stopped halfway across.",
              "speaker": "narrator",
              "emotion": "surprised",
              "action": "look"
            },
            {
              "text": "Professor Ozzy stood at its crowded little doorway.",
              "speaker": "narrator",
              "emotion": "surprised",
              "action": "look"
            },
            {
              "text": "We keep bumping blocks instead of building!",
              "speaker": "character",
              "emotion": "surprised",
              "action": "point"
            },
            {
              "text": "There is only room for one builder here.",
