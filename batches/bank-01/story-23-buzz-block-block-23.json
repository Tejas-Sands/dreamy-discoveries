        {
          "kind": "story",
          "background": "playground",
          "character": "bee",
          "secondCharacter": "owl",
          "energy": "upbeat",
          "holdSec": 1,
          "prop": "⛵",
          "question": null,
          "lines": [
            {
              "text": "Buzz wanted a bridge for a toy boat.",
              "speaker": "narrator",
              "emotion": "happy",
              "action": "look"
