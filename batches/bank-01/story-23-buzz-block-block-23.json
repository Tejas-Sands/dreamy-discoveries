              "speaker": "narrator",
              "emotion": "surprised",
              "action": "look"
            },
            {
              "text": "They both backed out to the same side.",
              "speaker": "narrator",
              "emotion": "surprised",
              "action": "look"
            },
            {
              "text": "We have built a very small traffic jam.",
              "speaker": "character",
              "emotion": "surprised",
              "action": "nod"
            },
            {
              "text": "With a surprisingly large amount of buzzing.",
              "speaker": "friend",
              "emotion": "surprised",
              "action": "nod"
            }
          ]
        },
        {
          "kind": "question",
          "background": "playground",
          "character": "bee",
          "secondCharacter": "owl",
          "energy": "calm",
          "holdSec": 3,
          "prop": "⛵",
          "question": {
            "answer": {
              "text": "Not easily!",
              "emoji": "💡"
            },
            "praise": "Yes! Not easily!"
          },
          "lines": [
            {
