        },
        {
          "kind": "question",
          "background": "snow",
          "character": "snowman",
          "secondCharacter": "bear",
          "energy": "calm",
          "holdSec": 3,
          "prop": "🍃",
          "question": {
            "answer": {
              "text": "No, it means friendly!",
              "emoji": "💡"
