            },
            {
              "text": "I am cooling it down, just to be certain.",
              "speaker": "character",
              "emotion": "thinking",
              "action": "think"
            },
            {
              "text": "Your welcome does not need a fan, Frosty.",
              "speaker": "friend",
              "emotion": "thinking",
              "action": "think"
            }
