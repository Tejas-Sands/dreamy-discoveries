            },
            {
              "text": "There is no warm thing anywhere near my seat.",
              "speaker": "character",
              "emotion": "thinking",
              "action": "think"
            },
            {
              "text": "The welcome is in my words, not the weather.",
              "speaker": "friend",
              "emotion": "thinking",
              "action": "think"
            }
          ]
