        {
          "kind": "story",
          "background": "park",
          "character": "dog",
          "secondCharacter": "sheep",
          "energy": "upbeat",
          "holdSec": 1,
          "prop": "🚪",
          "question": null,
          "lines": [
            {
              "text": "Buster looked both ways along the open path.",
