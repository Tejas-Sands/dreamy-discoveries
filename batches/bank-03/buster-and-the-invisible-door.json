          "energy": "upbeat",
          "holdSec": 1,
          "prop": "🚪",
          "question": null,
          "lines": [
            {
              "text": "Buster was playing at guarding a grand pretend palace.",
              "speaker": "narrator",
              "emotion": "neutral",
              "action": "look"
            },
            {
              "text": "Two little stones marked its important front doorway.",
              "speaker": "narrator",
              "emotion": "neutral",
              "action": "look"
            },
            {
              "text": "Visitors must enter through the official royal door.",
              "speaker": "character",
              "emotion": "happy",
              "action": "nod"
            },
            {
              "text": "Your palace has a wonderfully airy front garden.",
              "speaker": "friend",
              "emotion": "happy",
              "action": "nod"
            }
          ]
        },
        {
          "kind": "story",
          "background": "park",
          "character": "dog",
          "secondCharacter": "sheep",
          "energy": "upbeat",
          "holdSec": 1,
          "prop": "🚪",
          "question": null,
          "lines": [
            {
              "text": "Buster reached for an invisible golden handle.",
              "speaker": "narrator",
              "emotion": "neutral",
              "action": "look"
            },
            {
              "text": "He pulled so hard his ears tilted backward.",
              "speaker": "narrator",
              "emotion": "neutral",
              "action": "look"
            },
            {
              "text": "Oh dear. My invisible handle seems to be stuck.",
              "speaker": "character",
              "emotion": "happy",
              "action": "nod"
            },
            {
              "text": "Would an invisible push work any better?",
              "speaker": "friend",
              "emotion": "happy",
              "action": "nod"
            }
          ]
        },
        {
          "kind": "story",
          "background": "park",
          "character": "dog",
          "secondCharacter": "sheep",
          "energy": "upbeat",
          "holdSec": 1,
          "prop": "🚪",
          "question": null,
          "lines": [
            {
              "text": "Buster pushed the air with both his paws.",
              "speaker": "narrator",
              "emotion": "neutral",
              "action": "look"
            },
            {
              "text": "Nothing moved except his own waggling little tail.",
              "speaker": "narrator",
              "emotion": "neutral",
              "action": "look"
            },
            {
              "text": "This is an extremely stubborn invisible door.",
              "speaker": "character",
              "emotion": "happy",
              "action": "nod"
            },
            {
              "text": "Perhaps it has forgotten that you invented it.",
              "speaker": "friend",
              "emotion": "happy",
              "action": "nod"
            }
          ]
        },
        {
          "kind": "question",
          "background": "park",
