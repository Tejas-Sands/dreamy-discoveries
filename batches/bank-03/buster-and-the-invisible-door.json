              "text": "An open path!",
              "emoji": "💡"
            },
            "praise": "You thought about our friends!"
          },
          "lines": [
            {
              "text": "What is beside their pretend door?",
              "speaker": "narrator",
              "emotion": "thinking",
              "action": "think"
