        {
          "kind": "question",
          "background": "park",
          "character": "dog",
          "secondCharacter": "sheep",
          "energy": "calm",
          "holdSec": 3,
          "prop": "🚪",
          "question": {
            "answer": {
              "text": "No, they can pretend!",
              "emoji": "💡"
            },
            "praise": "You thought about our friends!"
          },
          "lines": [
            {
              "text": "Does their invisible door need a real key?",
              "speaker": "narrator",
              "emotion": "thinking",
              "action": "think"
