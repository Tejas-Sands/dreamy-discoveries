              "speaker": "narrator",
              "emotion": "neutral",
              "action": "look"
            },
            {
              "text": "I should have invented the walls first.",
              "speaker": "character",
              "emotion": "thinking",
              "action": "think"
            },
            {
              "text": "Or invented a door that enjoys opening.",
              "speaker": "friend",
              "emotion": "thinking",
              "action": "think"
            }
          ]
