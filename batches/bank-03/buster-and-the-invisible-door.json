          "energy": "upbeat",
          "holdSec": 1,
          "prop": "🚪",
          "question": null,
          "lines": [
            {
              "text": "Buster searched his imaginary pockets for a key.",
              "speaker": "narrator",
              "emotion": "neutral",
              "action": "look"
            },
            {
              "text": "Shaun waited beside the two little doorway stones.",
              "speaker": "narrator",
              "emotion": "neutral",
              "action": "look"
            },
            {
              "text": "The golden key must be in my other coat.",
              "speaker": "character",
              "emotion": "thinking",
              "action": "think"
            },
            {
              "text": "You do not appear to be wearing this coat.",
              "speaker": "friend",
              "emotion": "thinking",
              "action": "think"
            }
          ]
        },
        {
          "kind": "story",
          "background": "park",
          "character": "dog",
          "secondCharacter": "sheep",
          "energy": "upbeat",
          "holdSec": 1,
          "prop": "🚪",
          "question": null,
          "lines": [
