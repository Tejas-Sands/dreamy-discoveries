          "lines": [
            {
              "text": "Dot's final ring missed the little garden peg.",
              "speaker": "narrator",
              "emotion": "neutral",
              "action": "look"
            },
            {
              "text": "Buzz's ring stayed neatly around its rounded top.",
              "speaker": "narrator",
              "emotion": "neutral",
              "action": "look"
            },
            {
              "text": "I wanted to win that last turn so much.",
              "speaker": "character",
              "emotion": "sad",
              "action": "nod"
            },
            {
              "text": "I can see. Shall we collect our rings together?",
              "speaker": "friend",
              "emotion": "sad",
              "action": "nod"
            }
          ]
        },
        {
          "kind": "story",
          "background": "garden",
