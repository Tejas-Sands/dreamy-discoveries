              "emotion": "neutral",
              "action": "look"
            },
            {
              "text": "Now I have lost two whole games today!",
              "speaker": "character",
              "emotion": "sad",
              "action": "nod"
            },
            {
              "text": "Would you like a pause before another round?",
              "speaker": "friend",
              "emotion": "sad",
              "action": "nod"
            }
          ]
        },
