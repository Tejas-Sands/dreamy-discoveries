              "emotion": "neutral",
              "action": "look"
            },
            {
              "text": "I will throw harder and win this time.",
              "speaker": "character",
              "emotion": "worried",
              "action": "think"
            },
            {
              "text": "Then let us each have three turns again.",
              "speaker": "friend",
              "emotion": "worried",
              "action": "think"
            }
          ]
        },
        {
          "kind": "story",
          "background": "garden",
          "character": "ladybug",
          "secondCharacter": "bee",
          "energy": "calm",
          "holdSec": 1,
          "prop": "⭕",
          "question": null,
          "lines": [
            {
              "text": "Dot tossed so hard her ring passed the mat.",
