          "secondCharacter": "bee",
          "energy": "calm",
          "holdSec": 1,
          "prop": "⭕",
          "question": null,
          "lines": [
            {
              "text": "Dot folded her wings beside the playing mat.",
              "speaker": "narrator",
              "emotion": "neutral",
              "action": "look"
            },
            {
              "text": "She had enjoyed the game until the final score.",
              "speaker": "narrator",
              "emotion": "neutral",
              "action": "look"
            },
            {
              "text": "I liked tossing when I thought I might win.",
              "speaker": "character",
              "emotion": "sad",
              "action": "nod"
            },
            {
              "text": "That last miss felt disappointing, did it not?",
              "speaker": "friend",
              "emotion": "sad",
              "action": "nod"
            }
          ]
        },
        {
          "kind": "story",
          "background": "garden",
          "character": "ladybug",
          "secondCharacter": "bee",
          "energy": "calm",
          "holdSec": 1,
          "prop": "⭕",
          "question": null,
          "lines": [
            {
              "text": "Dot demanded another round before picking anything up.",
              "speaker": "narrator",
              "emotion": "neutral",
              "action": "look"
            },
            {
              "text": "Buzz agreed and put the peg back in place.",
