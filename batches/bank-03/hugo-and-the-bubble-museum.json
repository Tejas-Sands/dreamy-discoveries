              "speaker": "character",
              "emotion": "sad",
              "action": "nod"
            },
            {
              "text": "Perhaps your visitor disliked that very narrow doorway.",
              "speaker": "friend",
              "emotion": "sad",
              "action": "nod"
            }
          ]
        },
        {
          "kind": "question",
          "background": "garden",
