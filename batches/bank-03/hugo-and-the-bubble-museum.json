              "emotion": "happy",
              "action": "nod"
            },
            {
              "text": "I would, but your treasure has already popped.",
              "speaker": "friend",
              "emotion": "happy",
              "action": "nod"
            }
          ]
        },
        {
          "kind": "story",
          "background": "garden",
          "character": "hippo",
          "secondCharacter": "frog",
          "energy": "upbeat",
          "holdSec": 1,
          "prop": "🫧",
          "question": null,
          "lines": [
