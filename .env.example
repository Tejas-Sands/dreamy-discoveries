# ── LLM for script writing (set AT LEAST ONE; auto-detected in this order) ──
GROQ_API_KEY=            # https://console.groq.com  (free, fast)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey  (free tier; also enables TTS_ENGINE=gemini)
OPENROUTER_API_KEY=      # https://openrouter.ai/keys  (free models, small daily cap)
GITHUB_TOKEN=            # GitHub Models — being retired by GitHub (brownouts as of Sep 2026), don't rely on it

# Or point at any OpenAI-compatible endpoint explicitly (overrides auto-detect):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=...
# LLM_MODEL=llama-3.3-70b-versatile

# ── Text-to-speech ──
# "kokoro" (default: local Kokoro-82M model, no key, no cloud after first ~90MB download),
# "edge" (free Microsoft neural voices incl. child voices), or "gemini" (needs GEMINI_API_KEY)
TTS_ENGINE=kokoro
# Kokoro voices: af_heart (default), af_bella, af_nicole, am_michael, bf_emma, bm_george...
# Edge voices: en-US-AnaNeural (US child), en-GB-MaisieNeural (UK child), hi-IN-SwaraNeural
# Gemini voices: Leda, Kore, Puck
TTS_VOICE=af_heart

# Kokoro speaking speed (0.8 = slower/clearer for toddlers, 1.0 = normal)
TTS_SPEED=0.95

# ── Video length ──
# Target length in minutes; rhymes shorter than this get auto-reprised ("One more time!" + repeat)
TARGET_MINUTES=5.5

# ── Telegram delivery ──
TELEGRAM_BOT_TOKEN=      # from @BotFather
TELEGRAM_CHAT_ID=        # your user/chat id (message @userinfobot to get it)
