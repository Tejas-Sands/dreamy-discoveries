      "lines": [
        {
          "text": "Milo pretended to taste his invisible sandwich.",
          "speaker": "narrator",
          "emotion": "neutral",
          "action": "look",
          "callout": null,
          "sfx": []
        },
        {
          "text": "Kevin watched him chew several mouthfuls of air.",
          "speaker": "narrator",
          "emotion": "neutral",
          "action": "look",
          "callout": null,
          "sfx": []
        },
        {
          "text": "Delicious. But my real tummy is still hungry.",
          "speaker": "character",
          "emotion": "happy",
          "action": "nod",
          "callout": null,
          "sfx": []
