          "emotion": "happy",
          "action": "nod",
          "callout": null,
          "sfx": []
        },
        {
          "text": "I like it. Those words make my lunch feel unwelcome.",
          "speaker": "friend",
          "emotion": "happy",
          "action": "nod",
          "callout": null,
          "sfx": []
