      "question": null,
      "lines": [
        {
          "text": "They spread the cloth where the ground felt dry.",
          "speaker": "narrator",
          "emotion": "neutral",
          "action": "look",
          "callout": null,
          "sfx": []
        },
        {
          "text": "One loose corner fluttered in a very gentle breeze.",
