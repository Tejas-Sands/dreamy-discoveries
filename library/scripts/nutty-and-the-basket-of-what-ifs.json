          "speaker": "character",
          "emotion": "worried",
          "action": "think",
          "callout": null,
          "sfx": []
        },
        {
          "text": "Those are possibilities. Which things will help us today?",
          "speaker": "friend",
          "emotion": "worried",
          "action": "think",
          "callout": null,
          "sfx": []
        }
      ],
