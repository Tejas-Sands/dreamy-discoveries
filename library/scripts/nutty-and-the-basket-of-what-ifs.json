          "action": "look",
          "callout": {
            "kind": "number",
            "text": "3",
            "emoji": "🧺"
          },
          "sfx": []
        },
        {
          "text": "He filled them with things for more imaginary problems.",
          "speaker": "narrator",
          "emotion": "neutral",
          "action": "look",
          "callout": null,
          "sfx": []
        },
        {
          "text": "What if we drop a spoon, or lose the cloth?",
          "speaker": "character",
          "emotion": "worried",
          "action": "think",
          "callout": null,
          "sfx": []
        },
        {
          "text": "We can manage a small problem without packing the whole room.",
