          "emotion": "neutral",
          "action": "look",
          "callout": null,
          "sfx": []
        },
        {
          "text": "Then he packed a cushion for every imagined damp spot.",
          "speaker": "narrator",
          "emotion": "neutral",
          "action": "look",
          "callout": null,
          "sfx": []
        },
        {
          "text": "Now we can sit somewhere dry on every side.",
          "speaker": "character",
          "emotion": "worried",
          "action": "think",
          "callout": null,
          "sfx": []
        },
        {
          "text": "And the basket has become much harder to carry.",
          "speaker": "friend",
          "emotion": "worried",
          "action": "think",
          "callout": null,
          "sfx": []
        }
      ],
      "transition": "none",
