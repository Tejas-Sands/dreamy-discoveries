            "kind": "number",
            "text": "1",
            "emoji": "🧺"
          },
          "sfx": []
        },
        {
          "text": "Here is the small surprise I made a plan for.",
          "speaker": "character",
          "emotion": "happy",
          "action": "nod",
          "callout": null,
          "sfx": []
        },
        {
          "text": "Your smooth pebble can help while we sit down.",
