          "speaker": "character",
          "emotion": "happy",
          "action": "nod",
          "callout": null,
          "sfx": []
        },
        {
          "text": "I do like being invited to see your garden.",
          "speaker": "friend",
          "emotion": "happy",
          "action": "nod",
          "callout": null,
          "sfx": []
