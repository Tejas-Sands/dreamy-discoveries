        {
          "text": "Then we can leave the hugging out.",
          "speaker": "character",
          "emotion": "happy",
          "action": "nod",
          "callout": null,
          "sfx": []
        },
        {
          "text": "That would help me feel much more comfortable.",
          "speaker": "friend",
          "emotion": "happy",
          "action": "nod",
          "callout": null,
          "sfx": []
        }
