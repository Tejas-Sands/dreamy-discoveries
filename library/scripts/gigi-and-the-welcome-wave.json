        {
          "text": "I also planned a big welcome trumpet noise.",
          "speaker": "character",
          "emotion": "happy",
          "action": "nod",
          "callout": null,
          "sfx": []
        },
        {
          "text": "Could we leave that surprise out as well?",
          "speaker": "friend",
          "emotion": "happy",
          "action": "nod",
          "callout": null,
          "sfx": []
